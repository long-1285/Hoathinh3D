<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favoritesScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/favHeaderPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtFavTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phim Yêu Thích"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFavNewBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#10B981"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="+0 tập mới"
                        android:textColor="#0F172A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFavSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 phim đang theo dõi • 0 tập đã lưu offline"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCheckFavUpdates"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:focusable="true"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="🔔 Kiểm tra tập mới"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Offline Episodes Section -->
        <LinearLayout
            android:id="@+id/offlineSectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtOfflineSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬇ Tập Phim Đã Lưu Offline (0)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOfflineSectionSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="Phát trực tiếp từ bộ nhớ đệm ExoPlayer không cần mạng"
                android:textSize="11sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOfflineEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEmptyFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingVertical="48dp"
            android:text="♡ Chưa có phim yêu thích\nBấm vào biểu tượng trái tim trên các bộ phim để lưu lại xem sau"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
