<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Liquid Ambient Floating Orbs -->
    <FrameLayout
        android:id="@+id/orbsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/orb1"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_marginStart="-90dp"
            android:layout_marginTop="-100dp"
            android:background="@drawable/bg_orb_indigo" />

        <View
            android:id="@+id/orb2"
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-120dp"
            android:background="@drawable/bg_orb_cyan" />

        <View
            android:id="@+id/orb3"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_orb_pink" />
    </FrameLayout>

    <!-- Edge-to-Edge Content Layer scrolling underneath Floating Liquid Glass Chrome -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating iOS 27 Liquid Glass Header Sheet -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Brand Logo + Title -->
            <LinearLayout
                android:id="@+id/btnBrandHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusRight="@+id/headerSourcePill"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgHeaderAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="HoatHinh3D"
                    android:scaleType="centerCrop"
                    android:src="@drawable/app_avatar" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtHeaderBrand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.02"
                            android:maxLines="1"
                            android:text="HoatHinh3D"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHeaderBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1.5dp"
                            android:text="GLASS"
                            android:textColor="#FFFFFF"
                            android:textSize="7.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtHeaderSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donghua 3D • Liquid Glass UI"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Light/Dark & Theme Toggle -->
            <FrameLayout
                android:id="@+id/btnQuickTheme"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:contentDescription="Đổi giao diện Sáng / Tối"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnBrandHome"
                android:nextFocusRight="@+id/headerSourcePill">

                <ImageView
                    android:id="@+id/imgQuickThemeIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="Đổi giao diện"
                    android:src="@drawable/ic_theme_sun" />
            </FrameLayout>

            <!-- Source Selector Pill + Available Count -->
            <LinearLayout
                android:id="@+id/headerSourceWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/headerSourcePill"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusLeft="@+id/btnQuickTheme"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/txtHeaderSourceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="140dp"
                        android:paddingHorizontal="2dp"
                        android:text="YanHH3D Now"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgHeaderSourceChevron"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Mở danh sách nguồn"
                        android:src="@drawable/ic_chevron_down" />

                    <TextView
                        android:id="@+id/txtHeaderSourceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:maxLines="1"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="2 nguồn"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Liquid Glass Search Overlay (chỉ mở khi chọn Tìm kiếm) -->
    <LinearLayout
        android:id="@+id/floatingSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:elevation="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/searchBarBox"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:addStatesFromChildren="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/imgSearchIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Tìm kiếm"
                android:src="@drawable/ic_lg_search" />

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:hint="Tìm tiếng Việt (Đấu Phá, dau pha, dptk...)..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtSearchSourceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="2 Nguồn"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseSearchOverlay"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Đóng"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Floating Collapsed Top-Right Source Selector Pill (hiện khi lướt chọn trên màn hình chính) -->
    <FrameLayout
        android:id="@+id/btnCollapsedSource"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Chọn nguồn phim"
        android:elevation="14dp"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgCollapsedSourceIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Chọn nguồn phim"
            android:src="@drawable/ic_lg_sources" />
    </FrameLayout>

    <!-- Android TV 10-foot Left Navigation Rail (chỉ bật ở chế độ TV, luôn sẵn sàng D-Pad Trái) -->
    <LinearLayout
        android:id="@+id/tvNavRail"
        android:layout_width="156dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tvRailHome"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailSchedule"
            android:nextFocusRight="@+id/contentContainer"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailHomeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_explore" />

            <TextView
                android:id="@+id/tvRailHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Khám phá"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRailSchedule"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailHistory"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailHome"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailScheduleIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_schedule" />

            <TextView
                android:id="@+id/tvRailScheduleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Lịch chiếu"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRailHistory"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailFavorites"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailSchedule"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailHistoryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_history" />

            <TextView
                android:id="@+id/tvRailHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Lịch sử"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRailFavorites"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailSettings"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailHistory"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailFavoritesIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_favorites" />

            <TextView
                android:id="@+id/tvRailFavoritesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Yêu thích"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRailSettings"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailSearch"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailFavorites"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailSettingsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:id="@+id/tvRailSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Cài đặt"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:id="@+id/tvRailDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#3394A3B8" />

        <LinearLayout
            android:id="@+id/tvRailSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailSource"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailSettings"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailSearchIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lg_search" />

            <TextView
                android:id="@+id/tvRailSearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Tìm kiếm"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRailSource"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/tvRailTheme"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailSearch"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailSourceIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lg_sources" />

            <TextView
                android:id="@+id/tvRailSourceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Đổi nguồn"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRailTheme"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusRight="@+id/contentContainer"
            android:nextFocusUp="@+id/tvRailSource"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/tvRailThemeIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Đổi giao diện"
                android:src="@drawable/ic_theme_sun" />

            <TextView
                android:id="@+id/tvRailThemeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Chế độ Sáng"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating iOS 27 Liquid Glass Bottom Tab Capsule -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="12dp"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="5dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@+id/navSchedule"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Khám phá"
                android:src="@drawable/ic_nav_explore" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Khám phá"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSchedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/navHome"
            android:nextFocusRight="@+id/navHistory"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/navScheduleIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Lịch chiếu"
                android:src="@drawable/ic_nav_schedule" />

            <TextView
                android:id="@+id/navScheduleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lịch chiếu"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/navSchedule"
            android:nextFocusRight="@+id/navFavorites"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/navHistoryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Lịch sử"
                android:src="@drawable/ic_nav_history" />

            <TextView
                android:id="@+id/navHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lịch sử"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/navHistory"
            android:nextFocusRight="@+id/navSettings"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/navFavoritesIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Yêu thích"
                android:src="@drawable/ic_nav_favorites" />

            <TextView
                android:id="@+id/navFavoritesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Yêu thích"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/navFavorites"
            android:nextFocusRight="@+id/btnBottomSearch"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Cài đặt"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:id="@+id/navSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cài đặt"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnBottomSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Tìm kiếm phim"
            android:focusable="true"
            android:nextFocusLeft="@+id/navSettings">

            <ImageView
                android:id="@+id/imgBottomSearchIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Tìm kiếm"
                android:src="@drawable/ic_lg_search" />
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Collapsed Bottom-Right Search Pill (hiện khi lướt chọn trên màn hình chính) -->
    <FrameLayout
        android:id="@+id/btnCollapsedSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Tìm kiếm"
        android:elevation="14dp"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgCollapsedSearchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Tìm kiếm"
            android:src="@drawable/ic_lg_search" />
    </FrameLayout>

    <!-- Floating Translucent Liquid Glass Source Selector Overlay -->
    <FrameLayout
        android:id="@+id/floatingSourcePickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone">

        <View
            android:id="@+id/sourcePickerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/floatingSourcePickerContainer"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="74dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtSourcePickerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chọn nguồn phim"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSourcePickerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="2 nguồn"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSourcePicker"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Đóng chọn nguồn"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fadingEdgeLength="16dp"
                android:overScrollMode="ifContentScrolls"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sourcePickerListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/sourcePickerFooterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Translucent Liquid Glass Category ("Thể loại phim") Picker Overlay -->
    <FrameLayout
        android:id="@+id/floatingGenrePickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="21dp"
        android:visibility="gone">

        <View
            android:id="@+id/genrePickerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/floatingGenrePickerContainer"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="28dp"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtGenrePickerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thể loại phim"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSyncGenresNow"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="↻ Đồng bộ"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseGenrePicker"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Đóng thể loại phim"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtGenrePickerSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🟢 Đồng bộ theo thời gian thực từ nguồn Web"
                android:textSize="11sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fadingEdgeLength="14dp"
                android:overScrollMode="ifContentScrolls"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/genrePickerGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Liquid Glass Toast Banner -->
    <TextView
        android:id="@+id/toastBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:elevation="16dp"
        android:maxLines="2"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="✓ Đã kết nối nguồn phim"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
