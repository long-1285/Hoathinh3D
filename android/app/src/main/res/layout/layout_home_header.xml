<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Loading Feed Banner -->
    <TextView
        android:id="@+id/txtLoadingFeedBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="⬇ Đang kết nối cụm kho hoạt hình 3D..."
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Multi-Source Search Status Header (Adaptive 2-column on Tablet/TV, Source Chips on Mobile) -->
    <LinearLayout
        android:id="@+id/searchStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/searchStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left Source Column (shown on Tablet/TV 2-column search) -->
            <LinearLayout
                android:id="@+id/multiSearchLeftPanel"
                android:layout_width="196dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Right Search Summary & Mobile Source Strip -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSearchHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kết quả tìm kiếm"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSearchHeaderSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnHomeClearSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#33F43F5E"
                        android:focusable="true"
                        android:minHeight="0dp"
                        android:text="✕ Xóa tìm kiếm"
                        android:textAllCaps="false"
                        android:textColor="#F43F5E"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/multiSearchMobileScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/multiSearchMobileChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hero Spotlight Banner -->
    <FrameLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgHeroBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F172A"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#4F46E5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="NIÊN PHIÊN NỔI BẬT"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeroQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#33FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="4K 60FPS"
                    android:textColor="#67E8F9"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeroRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#33F59E0B"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="★ 9.9 • Tập 135"
                    android:textColor="#FCD34D"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Đấu Phá Thương Khung"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeroSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Battle Through The Heavens"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="#4F46E5"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_play_arrow_sm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem Ngay"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnHeroDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="#33FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_info_outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chi Tiết &amp; Tập"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/heroDotsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Continue Watching Section -->
    <LinearLayout
        android:id="@+id/continuePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtContinueHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Tiếp tục xem"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnContinueClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:padding="4dp"
                android:text="Xóa lịch sử"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

    <!-- Favorites New Episodes Alert Strip (chỉ hiện khi có tập mới ở Yêu thích) -->
    <LinearLayout
        android:id="@+id/favUpdatesPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtFavUpdatesHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔔 Mới ra mắt trong Yêu thích"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFavUpdatesAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Xem tất cả ›"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/favUpdatesChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Trending Carousel -->
    <LinearLayout
        android:id="@+id/trendingSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTrendingHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top 10 BXH Thịnh Hành"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

    <!-- TV Leanback Horizontal Rows Container -->
    <LinearLayout
        android:id="@+id/tvCarouselsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Genre Filter Chips -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGenres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:nestedScrollingEnabled="false" />

    <!-- Catalog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCatalogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kho Nguồn Phim Đang Chọn:"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCatalogSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="YanHH3D VIP"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCatalogCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="(0 kết quả)"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnRefreshTvFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="↻ Làm mới"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Simplified Filter Bar: Mới cập nhật (mặc định) • Đang chiếu • Hoàn thành • Nhiều tập -->
    <HorizontalScrollView
        android:id="@+id/catalogFilterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/catalogFilterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipStatusAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="30dp"
                android:nextFocusRight="@+id/chipStatusOngoing"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Mới cập nhật"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipStatusOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="30dp"
                android:nextFocusLeft="@+id/chipStatusAll"
                android:nextFocusRight="@+id/chipStatusCompleted"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Đang chiếu"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipStatusCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="30dp"
                android:nextFocusLeft="@+id/chipStatusOngoing"
                android:nextFocusRight="@+id/chipSortEpisodes"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Hoàn thành"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipSortEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="30dp"
                android:nextFocusLeft="@+id/chipStatusCompleted"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Nhiều tập"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/emptyCatalogBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtEmptyCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🎬 Không tìm thấy phim phù hợp với bộ lọc"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnResetCatalogFilters"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:focusable="true"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:text="↺ Đặt lại bộ lọc"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
